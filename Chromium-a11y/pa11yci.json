{
  "threshold": 0,
  "concurrency": 2,
  "defaults": {
    "standard": "WCAG2AA",
    "runners": [
      "axe",
      "htmlcs"
    ],
    "timeout": 30000,
    "wait": 2000,
    "levelCapWhenNeedsReview": "warning",
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-dev-shm-usage"
      ]
    },
    "ignore": [],
    "reporters": [
      "cli",
      [
        "json",
        {
          "fileName": "./pa11y-report.json"
        }
      ],
      [
        "pa11y-ci-reporter-html",
        {
          "destination": "./pa11y-html",
          "includeZeroIssues": true
        }
      ]
    ]
  },
    "urls": [
    { "url": "http://localhost:3000/site-test/page-correcte" },
    { "url": "http://localhost:3000/site-test/erreurs-bonus" },
    { "url": "http://localhost:3000/site-test/erreurs-bonus-2" },
    { "url": "http://localhost:3000/site-test/erreurs-images-couleurs" },
    { "url": "http://localhost:3000/site-test/erreurs-structure-formulaires" },
    { "url": "http://localhost:3000/site-test/erreurs-titres-reperes" },
    { "url": "http://localhost:3000/site-test/piege-blocage" },
    { "url": "http://localhost:3000/site-test/piege-boucle" },
    { "url": "http://localhost:3000/site-test/erreurs-composants" },
    { "url": "http://localhost:3000/site-test/erreurs-audit" },
    { "url": "http://127.0.0.1:3000/site-test/navigation/index" },
    { "url": "http://127.0.0.1:3000/site-test/navigation/page-a" },
    { "url": "http://127.0.0.1:3000/site-test/navigation/page-b" },
    { "url": "http://127.0.0.1:3000/site-test/navigation/page-c" },
    { "url": "http://127.0.0.1:3000/site-test/navigation/page-d" },
    { "url": "http://127.0.0.1:3000/site-test/navigation/page-e" },
	{ "url": "http://localhost:3000/site-test/erreurs-complements" }
  ]
}
