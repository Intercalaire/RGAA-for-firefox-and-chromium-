{
  "threshold": 0,
  "concurrency": 2,
  "defaults": {
    "standard": "WCAG2AA",
    "runners": [
      "axe",
      "htmlcs"
    ],
    "timeout": 30000,
    "wait": 2000,
    "levelCapWhenNeedsReview": "warning",
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-dev-shm-usage"
      ]
    },
    "ignore": [],
    "reporters": [
      "cli",
      [
        "json",
        {
          "fileName": "./pa11y-report.json"
        }
      ],
      [
        "pa11y-ci-reporter-html",
        {
          "destination": "./pa11y-html",
          "includeZeroIssues": true
        }
      ]
    ]
  },
  "urls": [
    "http://localhost:3000/site-test/page-correcte",
    "http://localhost:3000/site-test/erreurs-bonus",
    "http://localhost:3000/site-test/erreurs-bonus-2",
    "http://localhost:3000/site-test/erreurs-images-couleurs",
    "http://localhost:3000/site-test/erreurs-structure-formulaires",
    "http://localhost:3000/site-test/erreurs-titres-reperes",
    "http://localhost:3000/site-test/piege-blocage",
    "http://localhost:3000/site-test/piege-boucle",
    "http://localhost:3000/site-test/erreurs-composants",
    "http://localhost:3000/site-test/erreurs-audit",
    "http://127.0.0.1:3000/site-test/navigation",
    "http://127.0.0.1:3000/site-test/navigation/page-a",
    "http://127.0.0.1:3000/site-test/navigation/page-b",
    "http://127.0.0.1:3000/site-test/navigation/page-c",
    "http://127.0.0.1:3000/site-test/navigation/page-d",
    "http://127.0.0.1:3000/site-test/navigation/page-e",
    "http://localhost:3000/site-test/erreurs-complements",
    "http://127.0.0.1:3000/site-test/navigation/plan",
    "http://localhost:3000/site-test/erreurs-consultation",
    "http://localhost:3000/site-test/erreurs-presentation",
    "http://localhost:3000/site-test/erreurs-a-verifier"
  ]
}